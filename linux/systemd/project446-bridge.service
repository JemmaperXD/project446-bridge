[Unit]
Description=Project 446 bridge (127.0.0.1:443 -> gc.project446.com via HTTP proxies)
Documentation=https://github.com/JemmaperXD/project446-bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=project446
Group=project446
WorkingDirectory=/opt/project446-bridge
Environment=BRIDGE_STATE_DIR=/var/lib/project446-bridge
Environment=BRIDGE_STICKY_FIRST=1
ExecStart=/usr/bin/python3 /opt/project446-bridge/bridge.py
Restart=always
RestartSec=3
LimitNOFILE=65535

# Порт 443 без запуска от root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

# Минимальные права: пишем только в state-каталог.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
ReadWritePaths=/var/lib/project446-bridge

[Install]
WantedBy=multi-user.target
